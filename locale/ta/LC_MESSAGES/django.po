msgstr "சமீபத்திய வரலாறு"

msgid "Review my placement readiness"
msgstr "எனது வேலைவாய்ப்பு தயார்நிலையை மதிப்பாய்வு செய்யவும்"

msgid "Optimize my resume for FinTech"
msgstr "FinTech-க்காக எனது பயோடேட்டாவை மேம்படுத்தவும்"

msgid "Suggest high-growth career paths"
